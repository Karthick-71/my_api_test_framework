# ---------------------------------------------------------------------------
# Safety net: data files never get committed by accident.
# Spreadsheets, CSVs, JSON, logs and documents are blocked everywhere, and
# only the project's own files are re-allowed below.
# ---------------------------------------------------------------------------
*.csv
*.xlsx
*.xls
*.json
*.xml
*.txt
*.log
*.pdf
*.doc
*.docx
*.db
*.sqlite3

# Project files that are allowed back in
!test_data/api_test_cases.xlsx
!framework/schemas/*.json
!requirements.txt
!requirements-aws.txt

# Secrets and local config
.env
.env.*
!.env.example
config.local.py
local_settings.py
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
build/
dist/

# Test and lint caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Test run output
reports/
site/
.history/
.triage-tool/

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
~$*
