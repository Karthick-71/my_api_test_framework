# Copy to .env for local overrides. Never commit .env.
# Default (local): pytest starts the Orders API itself, nothing to set.
TEST_ENV=local

# Remote environments: dev | qa | staging | prod
# TEST_ENV=qa
# QA_BASE_URL=https://orders-qa.example.com
# QA_API_KEY=replace-me

API_TIMEOUT_S=10
RESPONSE_BUDGET_MS=800
LOG_LEVEL=INFO
