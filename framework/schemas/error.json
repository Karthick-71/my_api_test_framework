{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "code",
    "message"
  ],
  "properties": {
    "status": {
      "const": "error"
    },
    "code": {
      "type": "integer",
      "minimum": 400
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "error"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
