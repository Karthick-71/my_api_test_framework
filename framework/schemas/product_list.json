{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "code",
    "message",
    "data"
  ],
  "properties": {
    "status": {
      "const": "success"
    },
    "code": {
      "type": "integer"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_id",
          "name",
          "price"
        ],
        "properties": {
          "product_id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  }
}
