{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "code",
    "message",
    "data"
  ],
  "properties": {
    "status": {
      "const": "success"
    },
    "code": {
      "type": "integer"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order_id",
          "user_id",
          "product_id",
          "quantity",
          "payment_method",
          "delivery",
          "total"
        ],
        "properties": {
          "order_id": {
            "type": "integer",
            "minimum": 1
          },
          "user_id": {
            "type": "integer"
          },
          "product_id": {
            "type": "integer"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "payment_method": {
            "enum": [
              "card",
              "upi",
              "cod"
            ]
          },
          "delivery": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "address",
              "pincode"
            ],
            "properties": {
              "address": {
                "type": "string",
                "minLength": 5
              },
              "pincode": {
                "type": "string",
                "pattern": "^[1-9][0-9]{5}$"
              }
            }
          },
          "total": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  }
}
